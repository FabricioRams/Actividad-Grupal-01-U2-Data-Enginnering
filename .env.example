# Copy to .env for local configuration
ENVIRONMENT=local
WAREHOUSE_BACKEND=duckdb
DUCKDB_PATH=data/skypulse.duckdb

# For PostgreSQL (Neon / Render / Docker Compose):
# WAREHOUSE_BACKEND=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skypulse

# Optional: Dev.to API key for automated article publishing
# DEVTO_API_KEY=your_devto_api_key_here
